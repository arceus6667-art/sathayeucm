# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Authentication Configuration (Client-side)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_CLIENT_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="smart-sathaye.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="smart-sathaye"
VITE_FIREBASE_STORAGE_BUCKET="smart-sathaye.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="213587581314"
VITE_FIREBASE_APP_ID="1:213587581314:web:9ef1cb9b57984197ab179b"
VITE_FIREBASE_MEASUREMENT_ID="G-LHHV7B7RJM"

# Supabase Data Storage Configuration
VITE_SUPABASE_URL="https://gqeplhjtkggsohbwmqhx.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-Side Only Credentials (NEVER expose to browser or VITE_* variables)
# Note: Ensure the exposed service-role key is rotated in Supabase Dashboard before production use.
SUPABASE_SERVICE_ROLE_KEY="YOUR_ROTATED_SUPABASE_SERVICE_ROLE_KEY"
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=""

# Application Port (Defaults to 3000)
PORT=3000
